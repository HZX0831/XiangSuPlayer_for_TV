<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark">

    <!-- Bing Daily Wallpaper Background Image -->
    <ImageView
        android:id="@+id/ivBingWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Dark Tint Overlay for Controlling Wallpaper Opacity & High Text Contrast -->
    <View
        android:id="@+id/wallpaperOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A" />

    <!-- Main TV Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Navigation Bar -->
        <LinearLayout
            android:id="@+id/topNav"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Left: Logo & App Title (Using Original App Icon @mipmap/ic_launcher) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    android:id="@+id/appLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="像素播放器 TV"
                    android:textColor="@color/tv_accent_green"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Left Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Center: 3 Main Features (探索, 搜索, 我的库) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/navExplore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_explore_line"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:text="@string/tab_explore"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/navSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_search_line"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:text="@string/tab_search"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/navLibrary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_library_line"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:text="@string/tab_library"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Right Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Right: Player, History, Account & Settings Icons (Clean Vector Line Drawables) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/navPlayer"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_margin="0dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_player_line"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="8dp"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/navHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_margin="0dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_history_line"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="8dp"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/navLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_margin="0dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_login_line"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="8dp"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/navSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_margin="0dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_settings_line"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="8dp"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Content Container -->
        <FrameLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp" />

        <!-- Global Bottom MiniPlayer Bar -->
        <include
            android:id="@+id/layoutMiniPlayer"
            layout="@layout/layout_mini_player"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</FrameLayout>
