<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:drawableStart="@drawable/ic_settings_line"
        android:drawablePadding="8dp"
        android:text="设置中心"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Category Tabs (Frosted Liquid Glass Panel Container) -->
        <LinearLayout
            android:id="@+id/layoutSettingsCategories"
            android:layout_width="210dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_panel"
            android:orientation="vertical"
            android:padding="12dp">

            <Button
                android:id="@+id/btnTabAudio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_player_line"
                android:drawablePadding="10dp"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:nextFocusRight="@+id/rbLossless"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="音频与品质"
                android:textColor="@color/tv_accent_green"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTabSource"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_explore_line"
                android:drawablePadding="10dp"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:nextFocusRight="@+id/rbSourceNetease"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="音源与服务"
                android:textColor="@color/tv_text_secondary"
                android:textSize="15sp" />

            <!-- Wallpaper Tab Icon: Clean White Line Wallpaper Icon -->
            <Button
                android:id="@+id/btnTabWallpaper"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_wallpaper_line"
                android:drawablePadding="10dp"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:nextFocusRight="@+id/rbBingWallpaper"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="壁纸与背景"
                android:textColor="@color/tv_text_secondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnTabCache"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_trash_line"
                android:drawablePadding="10dp"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:nextFocusRight="@+id/btnClearCache"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="缓存与存储"
                android:textColor="@color/tv_text_secondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnTabAbout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_history_line"
                android:drawablePadding="10dp"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:nextFocusRight="@+id/btnDonateApp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="关于与团队"
                android:textColor="@color/tv_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Right Options Panel Container (Level 3 Panel) -->
        <FrameLayout
            android:id="@+id/panelSettingsContent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_weight="1">

            <!-- Panel 1: Audio Quality -->
            <LinearLayout
                android:id="@+id/panelAudio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="默认音频播放质量"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="根据网络状况与音响设备自动匹配最高采样率"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbStandard"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/btnTabAudio"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="标准品质 (128 kbps MP3)"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbHigh"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/btnTabAudio"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="极高品质 (320 kbps MP3/AAC)"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbLossless"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:checked="true"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/btnTabAudio"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="无损 FLAC 音质 (44.1kHz/16bit CD级)"
                        android:textColor="@color/tv_accent_green"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbHires"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/btnTabAudio"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="Hi-Res 高解析无损 (96kHz/24bit 母带级)"
                        android:textColor="@color/tv_accent_green"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnSaveAudioSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/selector_glass_button"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/btnTabAudio"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:text="保存音频设置"
                    android:textColor="@color/tv_accent_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Panel 2: Sound Source Options -->
            <LinearLayout
                android:id="@+id/panelSource"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="核心音源服务选择"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="设置播放器检索与播放的核心在线音乐服务源"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbSourceNetease"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:checked="true"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/btnTabSource"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="网易云音乐"
                        android:textColor="@color/tv_accent_green"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RadioGroup>
            </LinearLayout>

            <!-- Panel 3: Wallpaper Options -->
            <LinearLayout
                android:id="@+id/panelWallpaper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="全局壁纸与背景设置"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="选择使用 Bing 每日 UHD 壁纸或导入自定义网络图片 URL"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgWallpaperMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbBingWallpaper"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:checked="true"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/btnTabWallpaper"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="使用 Bing 每日超清壁纸 (默认)"
                        android:textColor="@color/tv_accent_green"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbCustomWallpaper"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/btnTabWallpaper"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="使用自定义网络图片 URL"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="15sp" />
                </RadioGroup>

                <EditText
                    android:id="@+id/etCustomWallpaperUrl"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/selector_card_bg"
                    android:hint="输入自定义壁纸图片 URL (如 https://example.com/bg.jpg)"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:nextFocusLeft="@+id/btnTabWallpaper"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:textColor="@color/tv_text_primary"
                    android:textColorHint="@color/tv_text_secondary"
                    android:textSize="14sp" />

                <!-- Wallpaper Dark Overlay Opacity Title & Preset Buttons -->
                <TextView
                    android:id="@+id/tvOpacityInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="背景暗色遮罩黑化程度：50%"
                    android:textColor="@color/tv_accent_green"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Quick Glass Preset Buttons for Easy Remote Click -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnOpacity0"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/selector_glass_button"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/btnTabWallpaper"
                        android:text="0% 通透"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnOpacity25"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/selector_glass_button"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/btnTabWallpaper"
                        android:text="25% 亮度"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnOpacity50"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/selector_glass_button"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/btnTabWallpaper"
                        android:text="50% 默认"
                        android:textColor="@color/tv_accent_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnOpacity75"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/selector_glass_button"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/btnTabWallpaper"
                        android:text="75% 较暗"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnOpacity90"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/selector_glass_button"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/btnTabWallpaper"
                        android:text="90% 极暗"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSaveWallpaper"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/selector_glass_button"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/btnTabWallpaper"
                        android:paddingLeft="24dp"
                        android:paddingRight="24dp"
                        android:text="保存壁纸"
                        android:textColor="@color/tv_accent_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnResetBingWallpaper"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/selector_glass_button"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/btnTabWallpaper"
                        android:paddingLeft="24dp"
                        android:paddingRight="24dp"
                        android:text="恢复 Bing 每日壁纸"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Panel 4: Cache Management -->
            <LinearLayout
                android:id="@+id/panelCache"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="缓存与存储管理"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCacheSizeInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_glass_panel"
                    android:padding="20dp"
                    android:text="已占用图片与音频临时缓存：计算中..."
                    android:textColor="@color/tv_text_primary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnClearCache"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/selector_glass_button"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/btnTabCache"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:text="清理本地缓存"
                    android:textColor="#ff4d4f"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Panel 5: About & Development Team & Acknowledgements & Donate -->
            <ScrollView
                android:id="@+id/panelAbout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关于应用"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- App Info & Donate Button Glass Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_glass_panel"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAppVersion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="像素播放器 TV v2.0.0 Preview"
                                android:textColor="@color/tv_accent_green"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="专为 Android 大屏电视与盒子量身打造的高保真音乐播放客户端。"
                                android:textColor="@color/tv_text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Donate Button placed right beside Version Name -->
                        <Button
                            android:id="@+id/btnDonateApp"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="16dp"
                            android:background="@drawable/selector_glass_button"
                            android:drawableStart="@drawable/ic_heart_line"
                            android:drawablePadding="6dp"
                            android:focusable="true"
                            android:nextFocusLeft="@+id/btnTabAbout"
                            android:paddingHorizontal="16dp"
                            android:text="支持与捐赠"
                            android:textColor="#FF6B6B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Section: 开发团队 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="开发团队"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_glass_panel"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- Dev 1: 想玩小恐龙 -->
                        <LinearLayout
                            android:id="@+id/cardDev1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/selector_card_bg"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:nextFocusLeft="@+id/btnTabAbout"
                            android:orientation="horizontal"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="12dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/avatar_produce" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="想玩小恐龙"
                                    android:textColor="@color/tv_text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="iOS / Mac / TV 开发"
                                    android:textColor="@color/tv_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Dev 2: R3n_011 -->
                        <LinearLayout
                            android:id="@+id/cardDev2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/selector_card_bg"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:nextFocusLeft="@+id/btnTabAbout"
                            android:orientation="horizontal"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="12dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/avatar_r3n" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="R3n_011"
                                    android:textColor="@color/tv_text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Android 开发"
                                    android:textColor="@color/tv_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Dev 3: HZX0831 -->
                        <LinearLayout
                            android:id="@+id/cardDev3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/selector_card_bg"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:nextFocusLeft="@+id/btnTabAbout"
                            android:orientation="horizontal"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="12dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/avatar_hzx0831" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="HZX0831"
                                    android:textColor="@color/tv_text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="TV 开发 / 测试"
                                    android:textColor="@color/tv_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Section: 鸣谢与贡献 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="鸣谢与特别贡献"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/cardThanks1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/selector_card_bg"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:nextFocusLeft="@+id/btnTabAbout"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="12dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/avatar_sennagi" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="千凪Sennagi"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="感谢对像素播放器的支持与帮助"
                                android:textColor="@color/tv_accent_green"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
