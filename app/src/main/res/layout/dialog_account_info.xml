<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/tv_card_bg"
    android:padding="28dp"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:elevation="16dp">
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/tv_text_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="�� 网易云账号信息"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/tv_accent_green"
        android:id="@+id/tvDialogNick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/tv_text_secondary"
        android:id="@+id/tvDialogUid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <Button
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ff4d4f"
            android:id="@+id/btnDialogLogout"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="�� 退出登录"
            android:layout_marginEnd="12dp"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/tv_text_primary"
            android:id="@+id/btnDialogClose"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="关闭"/>
    </LinearLayout>
</LinearLayout>
