<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="620dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_panel"
    android:elevation="16dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Dialog Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_heart_line" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="支持与捐赠"
            android:textColor="@color/tv_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseDonate"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/selector_glass_button"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:text="关闭 ✕"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="#3338BDF8" />

    <!-- Alipay & WeChat Payment QR Images Side by Side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Alipay QR Image -->
        <ImageView
            android:id="@+id/ivDonateAlipay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/img_donate_alipay" />

        <View
            android:layout_width="16dp"
            android:layout_height="match_parent" />

        <!-- WeChat Pay QR Image -->
        <ImageView
            android:id="@+id/ivDonateWechat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/img_donate_wechat" />
    </LinearLayout>

    <!-- Official Website & PayPal Info Text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_glass_panel"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="14dp"
        android:text="您可以在像素播放器官网 (pixel.grammx.asia) 使用PayPal支付\n请务必在官网上登记您的信息，以便后续回馈，感谢您的支持！！"
        android:textColor="@color/tv_accent_green"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
