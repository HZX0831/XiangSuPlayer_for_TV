<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark">

    <!-- Bing Wallpaper Background Image -->
    <ImageView
        android:id="@+id/ivBingWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Dark Tint Overlay for Wallpaper Visibility & Readability -->
    <View
        android:id="@+id/wallpaperOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A" />

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/topHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivDetailCover"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="歌单名称"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="共 0 首歌曲"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPlayAll"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/selector_glass_button"
                        android:drawableStart="@drawable/ic_play_compact"
                        android:drawablePadding="6dp"
                        android:focusable="true"
                        android:paddingHorizontal="16dp"
                        android:text="播放全部"
                        android:textColor="@color/tv_accent_green"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnBack"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/selector_glass_button"
                        android:drawableStart="@drawable/ic_prev_line"
                        android:drawablePadding="6dp"
                        android:focusable="true"
                        android:paddingHorizontal="16dp"
                        android:text="返回"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#3338bdf8" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGridSongs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true" />

        <!-- Pagination Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrevPage"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_glass_button"
                android:drawableStart="@drawable/ic_prev_line"
                android:drawablePadding="4dp"
                android:focusable="true"
                android:paddingHorizontal="16dp"
                android:text="上一页"
                android:textColor="@color/tv_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvGridPageInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:text="第 1 / 1 页"
                android:textColor="@color/tv_text_secondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnNextPage"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_glass_button"
                android:drawableStart="@drawable/ic_next_compact"
                android:drawablePadding="4dp"
                android:focusable="true"
                android:paddingHorizontal="16dp"
                android:text="下一页"
                android:textColor="@color/tv_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Global Bottom MiniPlayer Bar -->
        <include
            android:id="@+id/layoutMiniPlayer"
            layout="@layout/layout_mini_player"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</FrameLayout>
