<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layoutLoggedIn"
        android:background="@color/tv_card_bg"
        android:padding="32dp"
        android:visibility="gone"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:elevation="8dp">
        <TextView
            android:textSize="56sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="��"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/tv_accent_green"
            android:id="@+id/tvUserNick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/tv_text_secondary"
            android:id="@+id/tvUserId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ff4d4f"
            android:id="@+id/btnLogout"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:text="�� 退出当前账号"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layoutLoggedOut"
        android:background="@color/tv_card_bg"
        android:padding="32dp"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:elevation="8dp">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/tv_text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="�� 网易云账号扫码登录"/>
        <ImageView
            android:id="@+id/ivAccountQrCode"
            android:background="#ffffff"
            android:padding="10dp"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="20dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/tv_accent_green"
            android:id="@+id/tvAccountQrStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="请使用网易云音乐 App 扫描二维码"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/tv_text_primary"
            android:id="@+id/btnRefreshQr"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:text="�� 刷新二维码"/>
    </LinearLayout>
</LinearLayout>
